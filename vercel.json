{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": { 
        "installCommand": "npm install",
        "zeroConfig": true
      }
    }
  ],
  "routes": [
    {
      "src": "/why-me(.*)",
      "dest": "/why-me"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
